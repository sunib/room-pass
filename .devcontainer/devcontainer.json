{
  "name": "Room Pass DevContainer",
  "build": {
    "dockerfile": "Dockerfile",
    // Repo root, so the Dockerfile can reach go.mod for the module download
    // warm-up layer.
    "context": "..",
    "target": "dev"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1.10.0": {},
    "ghcr.io/devcontainers/features/common-utils:2.5.9": {
      "userUid": "automatic",
      "userGid": "automatic",
      "username": "vscode"
    },
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "runArgs": [
    "--group-add=docker",
    "--add-host=host.docker.internal:host-gateway",
    // Bounds only what runs in here: docker-outside-of-docker means the k3d
    // fixture's containers are siblings on the host daemon.
    "--memory=8g",
    "--memory-swap=12g"
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.shell.linux": "/bin/bash",
        "go.toolsManagement.checkForUpdates": "local",
        "go.useLanguageServer": true,
        "go.gopath": "/go",
        "gopls": {
          "build.directoryFilters": ["-node_modules", "-.local"]
        },
        "go.testExplorer.enable": true
      },
      "extensions": [
        "golang.go",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "ms-azuretools.vscode-docker",
        "anthropic.claude-code"
      ]
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh '${containerWorkspaceFolder}'",
  "postStartCommand": "bash .devcontainer/post-start.sh '${containerWorkspaceFolder}'",
  "remoteUser": "vscode",
  "mounts": [
    "source=gomodcache,target=/go/pkg/mod,type=volume",
    "source=gobuildcache,target=/home/vscode/.cache/go-build,type=volume",
    "source=npmcache,target=/home/vscode/.npm,type=volume",
    "source=room-pass-claudeconfig,target=/home/vscode/.claude,type=volume",
    // Its own empty kube config, never a shared one: the e2e fixture writes its
    // own kubeconfig under .local/ and nothing here should reach another cluster.
    "source=room-pass-dotkube,target=/home/vscode/.kube,type=volume",
    "source=ghconfig,target=/home/vscode/.config/gh,type=volume",
    "source=room-pass-persisted-home,target=/home/vscode/persisted-home,type=volume"
  ],
  "containerEnv": {
    "HOST_PROJECT_PATH": "${localWorkspaceFolder}",
    "PROJECT_PATH": "/workspaces/${localWorkspaceFolderBasename}",
    "GIT_USER_NAME": "${localEnv:GIT_USER_NAME}",
    "GIT_USER_EMAIL": "${localEnv:GIT_USER_EMAIL}"
  }
}
